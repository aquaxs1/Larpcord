{
    "appId": "dev.larpcord.app",
    "appName": "Larpcord",
    "webDir": "www",
    "server": {
        "url": "https://discord.com/app",
        "allowNavigation": [
            "discord.com",
            "*.discord.com",
            "discordapp.com",
            "*.discordapp.com",
            "*.hcaptcha.com",
            "hcaptcha.com"
        ],
        "errorPath": "index.html"
    },
    "android": {
        "allowMixedContent": false,
        "overrideUserAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/141.0.0.0 Safari/537.36"
    },
    "ios": {
        "contentInset": "always",
        "limitsNavigationsToAppBoundDomains": false,
        "preferredContentMode": "desktop"
    }
}
