# Copy to .env and fill in. Never commit .env.

# Domain that points to this server (free: https://www.duckdns.org)
SYNC_DOMAIN=larpcord.duckdns.org
# Must match the domain above (https)
PUBLIC_URL=https://larpcord.duckdns.org

# Discord Developer Portal → your application → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Long random string for moderation requests (openssl rand -hex 32)
ADMIN_KEY=
