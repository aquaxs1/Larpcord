{
    "name": "larpcord",
    "productName": "Larpcord",
    "version": "1.6.7",
    "private": true,
    "description": "Larpcord – a standalone Discord client for local, cosmetic larping (based on Vesktop)",
    "keywords": [],
    "homepage": "https://github.com/larpcord/larpcord",
    "license": "GPL-3.0-or-later",
    "author": "Larpcord contributors (based on Vesktop by Vendicated)",
    "main": "dist/js/main.js",
    "scripts": {
        "build": "tsx scripts/build/build.mts",
        "build:dev": "pnpm build --dev",
        "buildLibVesktop": "pnpm -C packages/libvesktop install && pnpm -C packages/libvesktop run build",
        "package": "pnpm build && electron-builder",
        "package:dir": "pnpm build && electron-builder --dir",
        "lint": "eslint",
        "lint:fix": "pnpm lint --fix",
        "start": "pnpm build && electron .",
        "start:dev": "pnpm build:dev && electron .",
        "start:watch": "pnpm build:dev && tsx scripts/startWatch.mts",
        "test": "pnpm lint && pnpm testTypes",
        "testTypes": "tsc --noEmit",
        "watch": "pnpm build --watch",
        "generateMeta": "tsx scripts/utils/generateMeta.mts"
    },
    "dependencies": {
        "arrpc": "github:Vencord/arrpc#1dc801e8ea14d96ce8dccff416417614f058afb8",
        "electron-updater": "6.6.2"
    },
    "optionalDependencies": {
        "@vencord/venmic": "^7.2.3"
    },
    "devDependencies": {
        "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@types/node": "^26.2.0",
        "@types/react": "19.2.9",
        "@vencord/types": "^1.15.1",
        "dotenv": "^17.3.1",
        "electron": "43.2.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^10.8.1",
        "eslint-import-resolver-alias": "^1.1.2",
        "eslint-plugin-path-alias": "^2.1.0",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-simple-header": "^1.2.2",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "eslint-plugin-unused-imports": "^4.4.1",
        "libvesktop": "link:packages/libvesktop",
        "prettier": "^3.9.6",
        "source-map-support": "^0.5.21",
        "tsx": "^4.23.12",
        "type-fest": "^5.8.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.67.0",
        "xml-formatter": "^3.6.7"
    },
    "packageManager": "pnpm@11.9.0",
    "engines": {
        "node": ">=22",
        "pnpm": ">=11"
    },
    "build": {
        "appId": "dev.larpcord.app",
        "productName": "Larpcord",
        "executableName": "larpcord",
        "files": [
            "!*",
            "!node_modules",
            "dist/js",
            "static",
            "package.json",
            "LICENSE"
        ],
        "protocols": {
            "name": "Discord",
            "schemes": [
                "discord"
            ]
        },
        "beforePack": "scripts/build/beforePack.mjs",
        "afterPack": "scripts/build/afterPack.mjs",
        "toolsets": {
            "appimage": "1.0.3"
        },
        "linux": {
            "icon": "build/icon.png",
            "category": "Network",
            "maintainer": "larpcord@users.noreply.github.com",
            "target": [
                {
                    "target": "deb",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "tar.gz",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "rpm",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                },
                {
                    "target": "AppImage",
                    "arch": [
                        "x64",
                        "arm64"
                    ]
                }
            ],
            "desktop": {
                "entry": {
                    "Name": "Larpcord",
                    "GenericName": "Internet Messenger",
                    "Type": "Application",
                    "Categories": "Network;InstantMessaging;Chat;",
                    "Keywords": "discord;larpcord;vencord;electron;chat;",
                    "MimeType": "x-scheme-handler/discord",
                    "StartupWMClass": "larpcord"
                }
            }
        },
        "mac": {
            "target": [
                {
                    "target": "default",
                    "arch": [
                        "universal"
                    ]
                }
            ],
            "category": "public.app-category.social-networking",
            "darkModeSupport": true,
            "extendInfo": {
                "NSMicrophoneUsageDescription": "This app needs access to the microphone",
                "NSCameraUsageDescription": "This app needs access to the camera",
                "com.apple.security.device.audio-input": true,
                "com.apple.security.device.camera": true,
                "CFBundleIconName": "Icon"
            },
            "requirements": "build/signing-requirements.txt",
            "notarize": true
        },
        "dmg": {
            "background": "build/background.tiff",
            "icon": "build/icon.icns",
            "iconSize": 105,
            "window": {
                "width": 512,
                "height": 340
            },
            "contents": [
                {
                    "x": 140,
                    "y": 160
                },
                {
                    "x": 372,
                    "y": 160,
                    "type": "link",
                    "path": "/Applications"
                }
            ]
        },
        "nsis": {
            "include": "build/installer.nsh",
            "oneClick": false,
            "artifactName": "Larpcord-Setup.exe",
            "shortcutName": "Larpcord",
            "uninstallDisplayName": "Larpcord"
        },
        "win": {
            "icon": "build/icon.ico",
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ]
        },
        "publish": null,
        "rpm": {
            "fpm": [
                "--rpm-rpmbuild-define=_build_id_links none"
            ]
        },
        "electronFuses": {
            "runAsNode": false,
            "enableCookieEncryption": false,
            "enableNodeOptionsEnvironmentVariable": false,
            "enableNodeCliInspectArguments": false,
            "enableEmbeddedAsarIntegrityValidation": false,
            "onlyLoadAppFromAsar": true,
            "loadBrowserProcessSpecificV8Snapshot": false,
            "grantFileProtocolExtraPrivileges": false
        },
        "extraResources": [
            {
                "from": "vencord",
                "to": "vencord",
                "filter": [
                    "vencordDesktop*.js",
                    "vencordDesktop*.css",
                    "package.json"
                ]
            }
        ]
    }
}
